# --- DEPENDANCES ---
# Ignore les modules Node.js à la racine et dans les sous-dossiers
node_modules/
.pnp/
.pnp.js

# --- VARIABLES D'ENVIRONNEMENT ET SECRETS ---
# Fichiers de configuration sensible (clés API, identifiants de BDD)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- BUILDS ET COMPILATIONS ---
# Dossiers de build pour React (Vite) et Node.js
dist/
build/
client/dist/
server/dist/

# --- LOGS ET TEMPORAIRES ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.tmp/
temp/

# --- TESTS ET COUVERTURE ---
coverage/
.nyc_output/

# --- IDE ET ÉDITEURS DE CODE ---
# VS Code
.vscode/*
!.vscode/extensions.json

# JetBrains (WebStorm, PhpStorm, etc.)
.idea/
*.iml

# Autres éditeurs / OS
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- FICHIERS SYSTÈME ---
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

